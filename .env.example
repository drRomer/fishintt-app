# =============================================================================
# Fishin't — Variables de entorno
# =============================================================================
# Copia este archivo a .env.local para desarrollo local. En Vercel, configúralas
# en Settings → Environment Variables (marca Production Y Preview según el caso).
# NUNCA commitees .env.local (está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard)
# -----------------------------------------------------------------------------
# Las encuentras en: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Solo para operaciones server-side (RLS bypass). NO exponer en cliente.
# Reservada: hoy la API usa la anon key (ver serverSupabase() en api/analyze).
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Usada por api/reset-password para el redirect; si se omite, usa localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# IA opcional para anatomía de enlaces (gratis) — /api/analyze
# -----------------------------------------------------------------------------
# Google Gemini — tier gratuito: https://aistudio.google.com/apikey
# Si se deja vacío, el análisis usa la heurística determinista (sin IA).
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Inteligencia de amenazas externa (opcional) — /api/analyze
# -----------------------------------------------------------------------------
# VirusTotal v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Google Safe Browsing v4 — Google Cloud Console → habilitar "Safe Browsing API"
# → Credenciales → API Key. https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_KEY=
